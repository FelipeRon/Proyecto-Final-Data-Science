PSET4_BACKEND=snowflake
MLFLOW_TRACKING_URI=http://mlflow:5000
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=PSET2_SVC
SNOWFLAKE_ROLE=PSET2_ROLE
SNOWFLAKE_WAREHOUSE=PSET2_WH
SNOWFLAKE_DATABASE=PSET2
SNOWFLAKE_PRIVATE_KEY_FILE=/run/secrets/snowflake_key.p8
SNOWFLAKE_SECRETS_DIR=./secrets
FORCE_FALLBACK=0

# Completa valores privados en .env
# Los flujos de Kestra cargan este archivo con `set -a; . .env`. Pon entre comillas
# dobles cualquier valor con espacios, por ejemplo una ruta como
# HOST_PROJECT_DIR="/run/desktop/mnt/host/c/Users/yo/Proyecto Data Science/repo".
KESTRA_DB_PASSWORD=
KESTRA_USER=
KESTRA_PASSWORD=
HOST_PROJECT_DIR=
KESTRA_SECRETS_DIR=

# Imagen de la API. Por defecto, la última publicada por CD en GHCR.
# Fija un commit con ghcr.io/feliperon/proyecto-final-data-science:<sha>
# o usa ai4i-pset4:local para servir la imagen construida en este equipo.
API_IMAGE=ghcr.io/feliperon/proyecto-final-data-science:latest
